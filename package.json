{
  "name": "folder-frog",
  "productName": "Folder Frog",
  "version": "1.0.0",
  "description": "Beri warna dan label status pada folder Windows",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "koffi": "^3.3.6"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.folderfrog.app",
    "productName": "Folder Frog",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "LICENSE.txt"
    },
    "copyright": "Copyright © 2026 Ari Fitriansyah",
    "extraResources": [
      "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt"
    ]
  },
  "author": {
    "name": "Ari Fitriansyah"
  },
  "license": "SEE LICENSE IN LICENSE.txt"
}